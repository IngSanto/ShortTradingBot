__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.ipynb_checkpoints/
results/

# Los datos de mercado se reconstruyen con scripts/fetch_*.py y no van a git...
data/**

# ...con una excepción: el universo diario de cripto SÍ se versiona (5 MB).
# El paper trading lo necesita para calcular la EMA(200), y sin él la Action
# arrancaría sin histórico y omitiría todos los símbolos. Además hace el
# registro de la puerta 4 autocontenido y auditable: cualquiera puede
# reproducir exactamente sobre qué precios se tomó cada decisión.
!data/cripto/
!data/cripto/*_1d.csv
# El calendario macro se versiona: es pequeño y sin el la calibracion de
# docs/10 no es reproducible -si manana la Fed reorganiza su web, este CSV
# sigue siendo el que produjo esos resultados.
!data/eventos/
!data/eventos/*.csv

# El estado del paper trading se versiona: es el registro de la puerta 4 y su
# valor está en que no se pueda rehacer.
!state/
!state/*.json
